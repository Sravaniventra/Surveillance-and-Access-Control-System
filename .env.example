# Application Configuration
APP_NAME="SecureVision Enterprise Surveillance"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
SECRET_KEY="super-secret-enterprise-surveillance-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL="sqlite:///./surveillance.db"

# Model Paths
YOLO_MODEL_PATH="yolov8n.pt"
YUNET_MODEL_PATH="models/face_detection_yunet.onnx"
SFACE_MODEL_PATH="models/face_recognition_sface.onnx"

# ML Thresholds
PERSON_CONFIDENCE_THRESHOLD=0.35
FACE_CONFIDENCE_THRESHOLD=0.60
FACE_MATCH_THRESHOLD=0.363
LIVENESS_LAPLACIAN_THRESHOLD=50.0

# Alert Settings
LOITERING_TIME_SECONDS=10.0
TAILGATING_TIME_SECONDS=2.5
